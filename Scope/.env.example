DATABASE_PATH=
GROQ_API_KEY=

# FEC API — Free key, instant approval at https://api.data.gov/signup
# DEMO_KEY works but is rate-limited to 30 requests/hour
# Get a real key for the full bootstrap_fec.py run (2,600+ members)
FEC_API_KEY=DEMO_KEY

# Email digest
GMAIL_FROM=
GMAIL_APP_PASSWORD=
DIGEST_RECIPIENT=

# Admin endpoint protection
ADMIN_KEY=

# OSINT — GDELT Project (no key required)
# https://www.gdeltproject.org/
# ReliefWeb (no key required)
# https://reliefweb.int/
# OpenSky Network (no key required for public ADS-B data)
# PatentsView (no key required) — https://patentsview.org/
# FARA bulk data (no key required) — https://efile.fara.gov/bulk/
# SEC EDGAR (no key required) — https://efts.sec.gov/
