
.env
.venv/
__pycache__/
.DS_Store
# .claude/ is machine-local by default, EXCEPT the subagent roster: those are
# team convention and belong in the repo. Git cannot re-include a file whose
# parent directory is excluded, so exclude the contents rather than the dir.
.claude/*
!.claude/agents/
.claude/agents/*
!.claude/agents/*.md
# Explicitly local, never tracked (belt and braces — already covered above):
.claude/settings.local.json
.claude/*.local.json
Scope/data/moat/
Scope/scripts/.fara_cache.json
*.csv
Scope/data/backups/
# The live database is operational state, not source. Prod's copy lives on the
# Railway volume (/app/data); tracking it here meant ordinary git operations
# rewound local data. Untracked 2026-07-26 (WS1) — the file stays on disk.
Scope/data/jpt.db
Scope/data/*.db
Scope/data/*.db-wal
Scope/data/*.db-shm
Scope/data/snapshot_*.db.gz
.obsidian/
.playwright-mcp/
